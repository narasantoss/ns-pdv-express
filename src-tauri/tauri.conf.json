{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ns-pdv-express",
  "version": "0.1.0",
  "identifier": "com.ns.pdvexpress",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NS PDV Express",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#F1F5F9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Sistema de Frente de Caixa e Controle de Estoque",
    "copyright": "NS Sistemas",
    "category": "Business",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "startMenuFolder": "NS PDV Express"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
