{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "allow-read-database-file",
    "allow-write-database-file",
    "allow-get-local-ip",
    "allow-obter-hwid-maquina",
    "allow-validar-e-ativar-licenca",
    "allow-verificar-status-licenca"
  ]
}
