{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "allow-read-database-file",
    "allow-write-database-file",
    "allow-get-local-ip",
    "allow-obter-hwid-maquina",
    "allow-ativar-serial",
    "allow-verificar-status-licenca",
    "allow-start-local-server",
    "allow-stop-local-server",
    "allow-is-local-server-running"
  ]
}
